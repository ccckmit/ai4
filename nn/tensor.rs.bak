use std::cell::RefCell;
use std::rc::Rc;
use std::vec::Vec;

fn unbroadcast(grad: &Vec<f32>, grad_shape: &[usize], shape: &[usize]) -> Vec<f32> {
    if grad_shape.iter().eq(shape.iter()) {
        return grad.clone();
    }
    let mut result = grad.clone();
    let ndim_diff = grad_shape.len() as isize - shape.len() as isize;
    if ndim_diff > 0 {
        let sum_axis: Vec<usize> = (0..ndim_diff as usize).collect();
        for ax in sum_axis {
            let stride: usize = result.iter().skip(ax).take(1).count();
        }
    }
    for i in 0..shape.len() {
        if shape[i] == 1 && grad_shape[i] > 1 {
        }
    }
    result
}

#[derive(Clone)]
pub struct Tensor {
    pub data: Rc<RefCell<Vec<f32>>>,
    pub grad: Rc<RefCell<Vec<f32>>>,
    pub shape: Vec<usize>,
    pub _backward: Rc<RefCell<Option<Box<dyn Fn()>>>>,
    pub _prev: Vec<Tensor>,
    pub requires_grad: bool,
}

impl Tensor {
    pub fn new(data: Vec<f32>, shape: Vec<usize>, requires_grad: bool) -> Self {
        let size = data.len();
        assert_eq!(size, shape.iter().product());
        let grad = vec![0.0; size];
        Tensor {
            data: Rc::new(RefCell::new(data)),
            grad: Rc::new(RefCell::new(grad)),
            shape,
            _backward: Rc::new(RefCell::new(None)),
            _prev: Vec::new(),
            requires_grad,
        }
    }

    pub fn from_vec(data: Vec<f32>, requires_grad: bool) -> Self {
        let shape = vec![data.len()];
        Self::new(data, shape, requires_grad)
    }

    pub fn from_vec_2d(data: Vec<f32>, rows: usize, cols: usize) -> Self {
        assert_eq!(data.len(), rows * cols);
        Self::new(data, vec![rows, cols], false)
    }

    pub fn zeros(shape: &[usize]) -> Self {
        let size = shape.iter().product();
        Self::new(vec![0.0; size], shape.to_vec(), false)
    }

    pub fn ones(shape: &[usize]) -> Self {
        let size = shape.iter().product();
        Self::new(vec![1.0; size], shape.to_vec(), false)
    }

    pub fn randn(shape: &[usize]) -> Self {
        use std::cell::RefMut;
        let size = shape.iter().product();
        let mut data = vec![0.0; size];
        for i in 0..size {
            let u: f32 = rand::random();
            let v: f32 = rand::random();
            data[i] = ((-2.0 * (u as f32).ln()).sqrt() * (2.0 * std::f32::consts::PI * v).cos()) * 0.08;
        }
        let mut t = Self::new(data, shape.to_vec(), false);
        let mut d = t.data.borrow_mut();
        for v in d.iter_mut() {
            *v = ((rand::random::<f32>() - 0.5) * 2.0) * 0.08;
        }
        t
    }

    pub fn shape_1d(&self) -> usize {
        if self.shape.len() == 1 { self.shape[0] } else { self.data.borrow().len() }
    }

    pub fn zero_grad(&mut self) {
        let mut g = self.grad.borrow_mut();
        for v in g.iter_mut() { *v = 0.0; }
    }

    pub fn backward(&self) {
        let mut topo = Vec::new();
        let mut visited = std::collections::HashSet::new();

        fn build_topo(v: &Tensor, visited: &mut std::collections::HashSet<usize>, topo: &mut Vec<Tensor>) {
            let id = v as *const Tensor as usize;
            if !visited.contains(&id) {
                visited.insert(id);
                for child in &v._prev {
                    build_topo(child, visited, topo);
                }
                topo.push(v.clone());
            }
        }
        build_topo(self, &mut visited, &mut topo);

        {
            let mut g = self.grad.borrow_mut();
            for v in g.iter_mut() { *v = 1.0; }
        }

        for v in topo.iter().rev() {
            if let Some(ref bw) = *v._backward.borrow() {
                bw();
            }
        }
    }

    pub fn add(&self, other: &Tensor) -> Tensor {
        let data = self.data.borrow();
        let other_data = other.data.borrow();
        let mut out_data = vec![0.0; data.len()];
        for i in 0..data.len() {
            out_data[i] = data[i] + other_data[i];
        }
        let requires_grad = self.requires_grad || other.requires_grad;
        let mut out = Tensor::new(out_data, self.shape.clone(), requires_grad);
        out._prev = vec![self.clone(), other.clone()];

        let data_clone = self.data.clone();
        let other_data_clone = other.data.clone();
        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();
        let other_grad = other.grad.clone();
        let self_shape = self.shape.clone();
        let other_shape = other.shape.clone();

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let out_g = out_data_rc.borrow();
            let d = data_clone.borrow();
            let od = other_data_clone.borrow();
            let mut sg = self_grad.borrow_mut();
            let mut og = other_grad.borrow_mut();
            for i in 0..d.len() {
                sg[i] += out_g[i];
                og[i] += out_g[i];
            }
        }))));
        out
    }

    pub fn mul(&self, other: &Tensor) -> Tensor {
        let data = self.data.borrow();
        let other_data = other.data.borrow();
        let mut out_data = vec![0.0; data.len()];
        for i in 0..data.len() {
            out_data[i] = data[i] * other_data[i];
        }
        let requires_grad = self.requires_grad || other.requires_grad;
        let mut out = Tensor::new(out_data, self.shape.clone(), requires_grad);
        out._prev = vec![self.clone(), other.clone()];

        let data_clone = self.data.clone();
        let other_data_clone = other.data.clone();
        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();
        let other_grad = other.grad.clone();

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let out_g = out_data_rc.borrow();
            let d = data_clone.borrow();
            let od = other_data_clone.borrow();
            let mut sg = self_grad.borrow_mut();
            let mut og = other_grad.borrow_mut();
            for i in 0..d.len() {
                sg[i] += out_g[i] * od[i];
                og[i] += out_g[i] * d[i];
            }
        }))));
        out
    }

    pub fn matmul(&self, other: &Tensor) -> Tensor {
        let a = self.data.borrow();
        let b = other.data.borrow();
        let (m, k1) = (self.shape[0], self.shape[1]);
        let (k2, n) = (other.shape[0], other.shape[1]);
        assert_eq!(k1, k2);
        let mut out_data = vec![0.0; m * n];
        for i in 0..m {
            for j in 0..n {
                let mut s = 0.0;
                for p in 0..k1 {
                    s += a[i * k1 + p] * b[p * n + j];
                }
                out_data[i * n + j] = s;
            }
        }
        let requires_grad = self.requires_grad || other.requires_grad;
        let mut out = Tensor::new(out_data, vec![m, n], requires_grad);
        out._prev = vec![self.clone(), other.clone()];

        let data_clone = self.data.clone();
        let other_data_clone = other.data.clone();
        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();
        let other_grad = other.grad.clone();

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let out_g = out_data_rc.borrow();
            let a = data_clone.borrow();
            let b = other_data_clone.borrow();
            let mut sg = self_grad.borrow_mut();
            let mut og = other_grad.borrow_mut();
            for i in 0..m {
                for j in 0..n {
                    for p in 0..k1 {
                        sg[i * k1 + p] += out_g[i * n + j] * b[p * n + j];
                        og[p * n + j] += a[i * k1 + p] * out_g[i * n + j];
                    }
                }
            }
        }))));
        out
    }

    pub fn relu(&self) -> Tensor {
        let data = self.data.borrow();
        let mut out_data = vec![0.0; data.len()];
        for i in 0..data.len() {
            out_data[i] = data[i].max(0.0);
        }
        let mut out = Tensor::new(out_data, self.shape.clone(), self.requires_grad);
        out._prev = vec![self.clone()];

        let data_clone = self.data.clone();
        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let out_g = out_data_rc.borrow();
            let d = data_clone.borrow();
            let mut sg = self_grad.borrow_mut();
            for i in 0..d.len() {
                if d[i] > 0.0 { sg[i] += out_g[i]; }
            }
        }))));
        out
    }

    pub fn tanh(&self) -> Tensor {
        let data = self.data.borrow();
        let mut out_data = vec![0.0; data.len()];
        for i in 0..data.len() {
            out_data[i] = data[i].tanh();
        }
        let mut out = Tensor::new(out_data, self.shape.clone(), self.requires_grad);
        out._prev = vec![self.clone()];

        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let out_g = out_data_rc.borrow();
            let mut sg = self_grad.borrow_mut();
            for i in 0..out_g.len() {
                let t = out_g[i].tanh();
                sg[i] += out_g[i] * (1.0 - t * t);
            }
        }))));
        out
    }

    pub fn sum(&self, axis: Option<usize>, keepdims: bool) -> Tensor {
        let data = self.data.borrow();
        let (m, n) = (self.shape[0], self.shape.get(1).copied().unwrap_or(1));
        let mut out_data = vec![0.0; if axis.is_none() { 1 } else { data.len() / n }];
        let mut out_shape = if axis.is_none() { vec![1] } else { self.shape.clone() };

        if let Some(ax) = axis {
            for i in 0..data.len() / n {
                let mut s = 0.0;
                for j in 0..n {
                    s += data[i * n + j];
                }
                out_data[i] = s;
            }
            if !keepdims { out_shape[ax] = 1; }
        } else {
            out_data[0] = data.iter().sum();
        }

        let mut out = Tensor::new(out_data, out_shape.clone(), self.requires_grad);
        out._prev = vec![self.clone()];

        let self_shape = self.shape.clone();
        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();
        let axis_clone = axis;
        let keepdims_clone = keepdims;

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let out_g = out_data_rc.borrow();
            let mut sg = self_grad.borrow_mut();
            if let Some(ax) = axis_clone {
                let stride = self_shape[ax];
                let outer: usize = self_shape[..ax].iter().product();
                let inner: usize = self_shape[ax + 1..].iter().product();
                for i in 0..outer {
                    for j in 0..inner {
                        for k in 0..stride {
                            let idx = i * stride * inner + k * inner + j;
                            sg[idx] += if keepdims_clone { out_g[i * inner + j] } else { out_g[i * inner + j] };
                        }
                    }
                }
            } else {
                for v in sg.iter_mut() { *v += out_g[0]; }
            }
        }))));
        out
    }

    pub fn reshape(&self, shape: Vec<usize>) -> Tensor {
        let data = self.data.borrow();
        let mut out = Tensor::new(data.clone(), shape, self.requires_grad);
        out._prev = vec![self.clone()];

        let self_shape = self.shape.clone();
        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let g = out_data_rc.borrow();
            let mut sg = self_grad.borrow_mut();
            for i in 0..g.len().min(sg.len()) {
                sg[i] += g[i];
            }
        }))));
        out
    }

    pub fn transpose(&self, ax1: usize, ax2: usize) -> Tensor {
        let data = self.data.borrow();
        let mut shape = self.shape.clone();
        shape.swap(ax1, ax2);
        let mut out_data = vec![0.0; data.len()];

        let stride_in: Vec<usize> = {
            let mut s = Vec::with_capacity(shape.len());
            let mut cur = 1;
            for &d in shape.iter().rev() {
                s.push(cur);
                cur *= d;
            }
            s.reverse();
            s
        };
        let stride_out: Vec<usize> = {
            let mut s = Vec::with_capacity(self.shape.len());
            let mut cur = 1;
            for &d in self.shape.iter().rev() {
                s.push(cur);
                cur *= d;
            }
            s.reverse();
            s
        };

        for i in 0..data.len() {
            let mut coords = vec![0; self.shape.len()];
            let mut tmp = i;
            for j in 0..self.shape.len() {
                coords[j] = (tmp / stride_out[j]) % self.shape[j];
            }
            coords.swap(ax1, ax2);
            let mut new_idx = 0;
            for j in 0..self.shape.len() {
                new_idx += coords[j] * stride_in[j];
            }
            out_data[new_idx] = data[i];
        }

        let mut out = Tensor::new(out_data, shape, self.requires_grad);
        out._prev = vec![self.clone()];

        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();
        let ax1_copy = ax1;
        let ax2_copy = ax2;
        let stride_in_copy = stride_in.clone();

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let g = out_data_rc.borrow();
            let mut sg = self_grad.borrow_mut();
            for i in 0..g.len() {
                let mut coords = vec![0; self.shape.len()];
                let mut tmp = i;
                for j in 0..self.shape.len() {
                    coords[j] = (tmp / stride_in_copy[j]) % self.shape[j];
                }
                coords.swap(ax1_copy, ax2_copy);
                let mut old_idx = 0;
                for j in 0..self.shape.len() {
                    old_idx += coords[j] * stride_out[j];
                }
                sg[old_idx] += g[i];
            }
        }))));
        out
    }

    pub fn softmax(&self, axis: usize) -> Tensor {
        let data = self.data.borrow();
        let max_val = data.iter().cloned().fold(f32::NEG_INFINITY, f32::max);
        let mut exps = vec![0.0; data.len()];
        let mut sum_exp = 0.0f32;
        for i in 0..data.len() {
            let e = (data[i] - max_val).exp();
            exps[i] = e;
            sum_exp += e;
        }
        let mut out_data: Vec<f32> = exps.iter().map(|e| e / sum_exp).collect();
        let mut out = Tensor::new(out_data, self.shape.clone(), self.requires_grad);
        out._prev = vec![self.clone()];

        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();
        let axis_copy = axis;

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let s = out_data_rc.borrow();
            let out_g = self.grad.borrow();
            let mut sg = self_grad.borrow_mut();
            let n = self.shape[axis_copy];
            let stride = self.shape[axis_copy + 1..].iter().product::<usize>();
            let batch = data.len() / n / stride;

            for b in 0..batch {
                for i in 0..stride {
                    let mut grad_s = vec![0.0; n];
                    for j in 0..n {
                        let idx = b * n * stride + j * stride + i;
                        grad_s[j] = out_g[idx];
                    }
                    for j in 0..n {
                        let idx = b * n * stride + j * stride + i;
                        let sum_grad_s = grad_s.iter().sum::<f32>();
                        sg[idx] += s[idx] * (grad_s[j] - sum_grad_s * s[idx]);
                    }
                }
            }
        }))));
        out
    }

    pub fn cross_entropy(&self, targets: &[usize]) -> Tensor {
        let data = self.data.borrow();
        let batch = targets.len();
        let seq = self.shape.get(1).copied().unwrap_or(1);
        let mut loss = 0.0f32;
        for (b, &t) in targets.iter().enumerate() {
            let idx = b * seq + t;
            loss -= (data[idx] + 1e-10f32).ln();
        }
        loss /= batch as f32;

        let mut out = Tensor::new(vec![loss], vec![1], self.requires_grad);
        out._prev = vec![self.clone()];

        let data_clone = self.data.clone();
        let out_data_rc = out.data.clone();
        let self_grad = self.grad.clone();
        let targets_copy = targets.to_vec();
        let batch_copy = batch;
        let seq_copy = seq;

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let d = data_clone.borrow();
            let mut sg = self_grad.borrow_mut();
            for (b, &t) in targets_copy.iter().enumerate() {
                let idx = b * seq_copy + t;
                sg[idx] -= 1.0 / batch_copy as f32;
            }
        }))));
        out
    }
}

pub fn cat(tensors: &[Tensor], axis: usize) -> Tensor {
    let mut shape = tensors[0].shape.clone();
    let total_size: usize = tensors.iter().map(|t| {
        let size: usize = t.shape.iter().product();
        shape[axis] = t.shape[axis];
        size
    }).sum();

    let mut out_data = vec![0.0; total_size];
    let mut offset = 0;
    for t in tensors {
        let data = t.data.borrow();
        for (i, &v) in data.iter().enumerate() {
            out_data[offset + i] = v;
        }
        offset += data.len();
    }

    let requires_grad = tensors.iter().any(|t| t.requires_grad);
    let mut out = Tensor::new(out_data, shape, requires_grad);
    out._prev = tensors.to_vec();

    let tensors_clone = tensors.to_vec();
    let out_data_rc = out.data.clone();
    let axis_copy = axis;

    out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
        if !out.requires_grad { return; }
        let g = out_data_rc.borrow();
        let mut offset = 0;
        for t in &tensors_clone {
            if t.requires_grad {
                let size = t.shape.iter().product::<usize>();
                let mut t_grad = t.grad.borrow_mut();
                for i in 0..size {
                    t_grad[i] += g[offset + i];
                }
            }
            offset += t.shape.iter().product::<usize>();
        }
    }))));
    out
}