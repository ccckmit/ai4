type Shape = number[];

export class NDArray {
  private _data: number[];
  private _shape: Shape;

  constructor(data: number | number[] | number[][], shape?: Shape) {
    if (typeof data === 'number') {
      this._data = [data];
      this._shape = shape ?? [];
    } else if (Array.isArray(data) && Array.isArray(data[0])) {
      this._data = data.flat();
      this._shape = [data.length, data[0].length];
    } else {
      this._data = data as number[];
      this._shape = shape ?? [data.length];
    }
  }

  get size(): number { return this._data.length; }
  get shape(): Shape { return this._shape; }
  get data(): number[] { return this._data; }

  get length(): number { return this._shape[0] ?? this._data.length; }
  get ndim(): number { return this._shape.length; }

  [Symbol.iterator](): Iterator<number> {
    return this._data[Symbol.iterator]();
  }

  private rowSize(): number {
    return this._shape.slice(1).reduce((a, b) => a * b, 1);
  }

  private rowData(idx: number): number[] {
    const size = this.rowSize();
    return this._data.slice(idx * size, (idx + 1) * size);
  }

  get(n: number): number;
  get(n: number, m: number): number;
  get(...indices: number[]): number {
    if (indices.length === 0) return this._data[0];
    const strides = this._shape.map((s, i) => this._shape.slice(i + 1).reduce((a, b) => a * b, 1));
    const idx = indices.reduce((acc, idx, i) => acc + idx * strides[i], 0);
    return this._data[idx];
  }

  row(idx: number): NDArray {
    return new NDArray(this.rowData(idx), this._shape.slice(1));
  }

  map(fn: (row: number[], i: number) => number[]): NDArray {
    if (this._shape.length === 1) {
      const result = this._data.map((v, i) => fn([v], i)[0]);
      return new NDArray(result, [result.length]);
    }
    const rows: number[][] = [];
    for (let i = 0; i < this._shape[0]; i++) {
      rows.push(fn(this.rowData(i), i));
    }
    return new NDArray(rows);
  }

  set(val: number, ...indices: number[]): void {
    const strides = this._shape.map((s, i) => this._shape.slice(i + 1).reduce((a, b) => a * b, 1));
    const idx = indices.reduce((acc, idx, i) => acc + idx * strides[i], 0);
    this._data[idx] = val;
  }

  set(val: number, ...indices: number[]): void {
    const strides = this._shape.map((s, i) => this._shape.slice(i + 1).reduce((a, b) => a * b, 1));
    const idx = indices.reduce((acc, idx, i) => acc + idx * strides[i], 0);
    this._data[idx] = val;
  }

  getAll(): number[] { return [...this._data]; }

  some(fn: (row: number[], i: number) => boolean): boolean {
    if (this._shape.length === 1) {
      return this._data.some((v, i) => fn([v], i));
    }
    for (let i = 0; i < this._shape[0]; i++) {
      if (fn(this.rowData(i), i)) return true;
    }
    return false;
  }

  every(fn: (row: number[], i: number) => boolean): boolean {
    if (this._shape.length === 1) {
      return this._data.every((v, i) => fn([v], i));
    }
    for (let i = 0; i < this._shape[0]; i++) {
      if (!fn(this.rowData(i), i)) return false;
    }
    return true;
  }

  copy(): NDArray {
    return new NDArray([...this._data], [...this._shape]);
  }

  reshape(...shape: Shape): NDArray {
    const result = new NDArray([...this._data]);
    (result as any)._shape = shape;
    return result;
  }
}

function broadcastShape(a: Shape, b: Shape): Shape {
  const maxLen = Math.max(a.length, b.length);
  const ra = Array(maxLen - a.length).fill(1).concat(a);
  const rb = Array(maxLen - b.length).fill(1).concat(b);
  return ra.map((v, i) => Math.max(v, rb[i]));
}

function calcSize(shape: Shape): number {
  return shape.reduce((a, b) => a * b, 1);
}

export function array(data: number | number[] | number[][]): NDArray {
  return new NDArray(data);
}

export function zeros(shape: Shape): NDArray {
  return new NDArray(new Array(calcSize(shape)).fill(0), shape);
}

export function zerosLike(a: NDArray): NDArray {
  return zeros(a.shape);
}

export function ones(shape: Shape): NDArray {
  return new NDArray(new Array(calcSize(shape)).fill(1), shape);
}

export function onesLike(a: NDArray): NDArray {
  return ones(a.shape);
}

function broadcastTo(arr: NDArray, shape: Shape): NDArray {
  if (arr.shape.length === shape.length && arr.shape.every((d, i) => d === shape[i])) return arr;
  const size = calcSize(shape);
  const result = new Array(size);
  const strides: number[] = [];
  for (let i = shape.length - 1, s = 1; i >= 0; i--) { strides.unshift(s); s *= shape[i]; }
  const arrStrides: number[] = [];
  for (let i = arr.shape.length - 1, s = 1; i >= 0; i--) { arrStrides.unshift(s); s *= arr.shape[i]; }
  for (let i = 0; i < size; i++) {
    const coords: number[] = [];
    let rem = i;
    for (let j = 0; j < shape.length; j++) {
      coords.push(Math.floor(rem / strides[j]) % shape[j]);
      rem = Math.floor(rem / strides[j]);
    }
    const arrCoords = coords.map((c, i) => {
      const dim = arr.shape.length - shape.length + i;
      return dim >= 0 ? c % arr.shape[dim] : 0;
    }).reverse();
    const flatIdx = arrCoords.reduce((acc, idx, si) => acc + idx * arrStrides[si], 0);
    result[i] = arr.data[flatIdx];
  }
  return new NDArray(result, shape);
}

export function unbroadcast(grad: NDArray, shape: Shape): NDArray {
  if (grad.shape.length === shape.length && grad.shape.every((d, i) => d === shape[i])) return grad;
  let result = grad;
  const ndimDiff = grad.shape.length - shape.length;
  if (ndimDiff > 0) {
    result = sum(result, Array.from({length: ndimDiff}, (_, i) => i));
  }
  for (let i = 0; i < shape.length; i++) {
    if (shape[i] === 1 && result.shape[i] > 1) {
      result = sum(result, [i]);
    }
  }
  return result;
}

function elemwise(op: (a: number, b: number) => number, a: NDArray, b: NDArray): NDArray {
  const shape = broadcastShape(a.shape, b.shape);
  const aBcast = broadcastTo(a, shape);
  const bBcast = broadcastTo(b, shape);
  const data = aBcast.data.map((v, i) => op(v, bBcast.data[i]));
  return new NDArray(data, shape);
}

export function add(a: NDArray, b: NDArray): NDArray {
  return elemwise((x, y) => x + y, a, b);
}

export function sub(a: NDArray, b: NDArray): NDArray {
  return elemwise((x, y) => x - y, a, b);
}

export function mul(a: NDArray, b: NDArray): NDArray {
  return elemwise((x, y) => x * y, a, b);
}

export function div(a: NDArray, b: NDArray): NDArray {
  return elemwise((x, y) => x / y, a, b);
}

export function pow(a: NDArray, n: number): NDArray {
  return new NDArray(a.data.map(v => Math.pow(v, n)), a.shape);
}

export function sqrt(a: NDArray): NDArray {
  return new NDArray(a.data.map(v => Math.sqrt(v)), a.shape);
}

export function exp(a: NDArray): NDArray {
  return new NDArray(a.data.map(v => Math.exp(v)), a.shape);
}

export function log(a: NDArray): NDArray {
  return new NDArray(a.data.map(v => Math.log(v)), a.shape);
}

export function abs(a: NDArray): NDArray {
  return new NDArray(a.data.map(v => Math.abs(v)), a.shape);
}

export function sign(a: NDArray): NDArray {
  return new NDArray(a.data.map(v => Math.sign(v)), a.shape);
}

export function maximum(val: number, a: NDArray): NDArray {
  return new NDArray(a.data.map(v => Math.max(val, v)), a.shape);
}

export function minimum(val: number, a: NDArray): NDArray {
  return new NDArray(a.data.map(v => Math.min(val, v)), a.shape);
}

export function clip(a: NDArray, minVal?: number, maxVal?: number): NDArray {
  return new NDArray(a.data.map(v => {
    if (minVal !== undefined && v < minVal) return minVal;
    if (maxVal !== undefined && v > maxVal) return maxVal;
    return v;
  }), a.shape);
}

export function relu(a: NDArray): NDArray { return maximum(0, a); }
export function tanh(a: NDArray): NDArray { return new NDArray(a.data.map(v => Math.tanh(v)), a.shape); }
export function sigmoid(a: NDArray): NDArray { return new NDArray(a.data.map(v => 1 / (1 + Math.exp(-v))), a.shape); }
export function square(a: NDArray): NDArray { return mul(a, a); }

export function sum(a: NDArray, axis?: number | number[], keepdims: boolean = false): NDArray {
  if (axis === undefined) {
    const s = a.data.reduce((acc, v) => acc + v, 0);
    const shape = keepdims ? Array(a.shape.length).fill(1) : [];
    return new NDArray(s, shape);
  }
  const axes = typeof axis === 'number' ? [axis] : axis;
  const shape = keepdims ? [...a.shape] : [...a.shape];
  axes.forEach(ax => shape[ax] = 1);

  const stride: number[] = [];
  for (let i = a.shape.length - 1, s = 1; i >= 0; i--) { stride.unshift(s); s *= a.shape[i]; }

  const result: number[] = [];
  const totalBlocks = a.shape.slice(0, axes[0] ?? 1).reduce((x, y) => x * y, 1);
  const blockSize = stride[axes[0]] * a.shape[axes[0]];

  for (let b = 0; b < totalBlocks; b++) {
    for (let inner = 0; inner < blockSize / a.shape[axes[0]]; inner++) {
      let s = 0;
      for (let k = 0; k < a.shape[axes[0]]; k++) {
        s += a.data[b * blockSize + k * stride[axes[0]] + inner];
      }
      result.push(s);
    }
  }
  return new NDArray(result, shape);
}

export function mean(a: NDArray, axis?: number | number[], keepdims: boolean = false): NDArray {
  if (axis === undefined) {
    const s = a.data.reduce((acc, v) => acc + v, 0) / a.size;
    return new NDArray(s, keepdims ? Array(a.shape.length).fill(1) : []);
  }
  const n = typeof axis === 'number' ? a.shape[axis] : axis.reduce((acc, ax) => acc * a.shape[ax], 1);
  return div(sum(a, axis, keepdims), n);
}

export function max(a: NDArray, axis: number = -1, keepdims: boolean = false): NDArray {
  const shape = [...a.shape];
  shape[axis] = 1;
  const stride: number[] = [];
  for (let i = a.shape.length - 1, s = 1; i >= 0; i--) { stride.unshift(s); s *= a.shape[i]; }

  const result: number[] = [];
  const outerDim = a.shape.slice(0, axis).reduce((x, y) => x * y, 1);
  const innerDim = a.shape.slice(axis + 1).reduce((x, y) => x * y, 1);
  const axisSize = a.shape[axis];

  for (let outer = 0; outer < outerDim; outer++) {
    for (let inner = 0; inner < innerDim; inner++) {
      let maxVal = -Infinity;
      for (let k = 0; k < axisSize; k++) {
        const idx = outer * axisSize * stride[axis] + k * stride[axis] + inner;
        if (a.data[idx] > maxVal) maxVal = a.data[idx];
      }
      result.push(maxVal);
    }
  }
  return new NDArray(result, shape);
}

export function greater(a: NDArray, b: NDArray | number): NDArray {
  const bArr = typeof b === 'number' ? new NDArray(new Array(a.size).fill(b), a.shape) : b;
  return elemwise((x, y) => x > y ? 1 : 0, a, bArr);
}

export function greaterEqual(a: NDArray, b: NDArray | number): NDArray {
  const bArr = typeof b === 'number' ? new NDArray(new Array(a.size).fill(b), a.shape) : b;
  return elemwise((x, y) => x >= y ? 1 : 0, a, bArr);
}

export function lessEqual(a: NDArray, b: NDArray | number): NDArray {
  const bArr = typeof b === 'number' ? new NDArray(new Array(a.size).fill(b), a.shape) : b;
  return elemwise((x, y) => x <= y ? 1 : 0, a, bArr);
}

export function equal(a: NDArray, b: NDArray | number): NDArray {
  const bArr = typeof b === 'number' ? new NDArray(new Array(a.size).fill(b), a.shape) : b;
  return elemwise((x, y) => x === y ? 1 : 0, a, bArr);
}

function calcStrides(shape: Shape): number[] {
  const s: number[] = [];
  for (let i = shape.length - 1, cur = 1; i >= 0; i--) { s.unshift(cur); cur *= shape[i]; }
  return s;
}

export function swapaxes(a: NDArray, ax1: number, ax2: number): NDArray {
  const shape = [...a.shape];
  [shape[ax1], shape[ax2]] = [shape[ax2], shape[ax1]];
  const stride = calcStrides(shape);
  const newStride = calcStrides(shape);
  [newStride[ax1], newStride[ax2]] = [newStride[ax2], newStride[ax1]];
  const result = new Array(a.data.length);
  for (let i = 0; i < a.data.length; i++) {
    const coords: number[] = [];
    let rem = i;
    for (let j = 0; j < shape.length; j++) {
      coords.push(Math.floor(rem / stride[j]) % shape[j]);
      rem = Math.floor(rem / stride[j]);
    }
    [coords[ax1], coords[ax2]] = [coords[ax2], coords[ax1]];
    const flatOld = coords.reduce((acc, idx, si) => acc + idx * newStride[si], 0);
    result[i] = a.data[flatOld];
  }
  return new NDArray(result, shape);
}

export function transpose(a: NDArray, ax1: number, ax2: number): NDArray {
  return swapaxes(a, ax1, ax2);
}

export function matmul(a: NDArray, b: NDArray): NDArray {
  if (a.shape.length !== 2 || b.shape.length !== 2) throw new Error('matmul requires 2D');
  const [m, k] = a.shape;
  const [k2, n] = b.shape;
  if (k !== k2) throw new Error(`matmul shape mismatch: ${k} vs ${k2}`);
  const result: number[] = new Array(m * n);
  for (let i = 0; i < m; i++) {
    for (let j = 0; j < n; j++) {
      let s = 0;
      for (let p = 0; p < k; p++) {
        s += a.get(i, p) * b.get(p, j);
      }
      result[i * n + j] = s;
    }
  }
  return new NDArray(result, [m, n]);
}

export function where(mask: NDArray, thenVal: number | NDArray, elseVal: NDArray): NDArray {
  const thenArr = typeof thenVal === 'number' ? new NDArray(new Array(mask.size).fill(thenVal), mask.shape) : thenVal;
  return elemwise((c, t, e) => c !== 0 ? t : e, mask, thenArr, elseVal);
}

export function expandDims(a: NDArray, axis: number): NDArray {
  const shape = [...a.shape];
  shape.splice(axis, 0, 1);
  return a.reshape(...shape);
}

export function split(a: NDArray, indices: number[], axis: number): NDArray[] {
  const sizes = indices.map((idx, i) => (i === 0 ? idx : idx - indices[i - 1]));
  sizes.push(a.shape[axis] - indices[indices.length - 1]);
  const stride = calcStrides(a.shape);
  const axisStride = stride[axis];
  const result: NDArray[] = [];
  let offset = 0;
  for (const size of sizes) {
    const blockSize = size * axisStride;
    const blockData = a.data.slice(offset, offset + blockSize);
    const prefixShape = a.shape.slice(0, axis);
    const suffixShape = a.shape.slice(axis + 1);
    result.push(new NDArray(blockData, [...prefixShape, size, ...suffixShape]));
    offset += blockSize;
  }
  return result;
}

export function concatenate(arrays: NDArray[], axis: number): NDArray {
  if (arrays.length === 0) throw new Error('concatenate requires at least one array');
  const shape = [...arrays[0].shape];
  shape[axis] = arrays.reduce((acc, a) => acc + a.shape[axis], 0);
  const result = new Array(calcSize(shape));
  const stride = calcStrides(shape);
  let offset = 0;
  for (const arr of arrays) {
    const arrStride = calcStrides(arr.shape);
    for (let i = 0; i < arr.data.length; i++) {
      const coords: number[] = [];
      let rem = i;
      for (let j = 0; j < arr.shape.length; j++) {
        coords.push(Math.floor(rem / arrStride[j]) % arr.shape[j]);
        rem = Math.floor(rem / arrStride[j]);
      }
      coords[axis] += offset;
      const flatIdx = coords.reduce((acc, idx, ci) => acc + idx * stride[ci], 0);
      result[flatIdx] = arr.data[i];
    }
    offset += arr.shape[axis];
  }
  return new NDArray(result, shape);
}

// ===========================================================================
// Tensor with autograd
// ===========================================================================

export class Tensor {
  data: NDArray;
  _grad: NDArray | null = null;
  _backward: () => void;
  _prev: Set<Tensor>;
  requires_grad: boolean;

  constructor(data: NDArray | number | number[], _children: Tensor[] = [], requiresGrad = false) {
    if (data instanceof NDArray) {
      this.data = data;
    } else if (typeof data === 'number') {
      this.data = new NDArray(data);
    } else if (Array.isArray(data) && typeof data[0] === 'number') {
      this.data = new NDArray(data as number[]);
    } else {
      this.data = new NDArray(data as number[][]);
    }
    this._grad = null;
    this._backward = () => {};
    this._prev = new Set(_children);
    this.requires_grad = requiresGrad;
  }

  get grad(): NDArray {
    if (!this._grad) {
      this._grad = zerosLike(this.data);
    }
    return this._grad;
  }

  set grad(g: NDArray | number[][] | number[]) {
    if (Array.isArray(g)) {
      this._grad = new NDArray(g as number[][]);
    } else {
      this._grad = g as NDArray;
    }
  }

  row(i: number): NDArray {
    return this.data.row(i);
  }

  static from(data: number[][] | number[], requiresGrad = false): Tensor {
    const nd = Array.isArray(data) && Array.isArray(data[0])
      ? new NDArray(data as number[][])
      : new NDArray([data] as number[][], [1, (data as number[]).length]);
    return new Tensor(nd, [], requiresGrad);
  }

  get shape(): number[] { return this.data.shape; }

  zeroGrad(): void { this.grad = zerosLike(this.data); }

  backward(): void {
    const topo: Tensor[] = [];
    const visited = new Set<Tensor>();
    const buildTopo = (v: Tensor): void => {
      if (!visited.has(v)) {
        visited.add(v);
        for (const child of v._prev) buildTopo(child);
        topo.push(v);
      }
    };
    buildTopo(this);
    this.grad = onesLike(this.data);
    for (let i = topo.length - 1; i >= 0; i--) topo[i]._backward();
  }

  add(other: Tensor | number): Tensor {
    const otherT = other instanceof Tensor ? other : new Tensor(other);
    const out = new Tensor(add(this.data, otherT.data), [this, otherT], this.requires_grad || otherT.requires_grad);
    out._backward = () => {
      this.grad = add(this.grad, unbroadcast(out.grad, this.data.shape));
      otherT.grad = add(otherT.grad, unbroadcast(out.grad, otherT.data.shape));
    };
    return out;
  }

  mul(other: Tensor | number): Tensor {
    const otherT = other instanceof Tensor ? other : new Tensor(other);
    const out = new Tensor(mul(this.data, otherT.data), [this, otherT], this.requires_grad || otherT.requires_grad);
    out._backward = () => {
      this.grad = add(this.grad, unbroadcast(mul(out.grad, otherT.data), this.data.shape));
      otherT.grad = add(otherT.grad, unbroadcast(mul(out.grad, this.data), otherT.data.shape));
    };
    return out;
  }

  matmul(other: Tensor): Tensor {
    const out = new Tensor(matmul(this.data, other.data), [this, other], this.requires_grad || other.requires_grad);
    out._backward = () => {
      const otherT = transpose(other.data, -1, -2);
      const selfT = transpose(this.data, -1, -2);
      this.grad = add(this.grad, unbroadcast(matmul(out.grad, otherT), this.data.shape));
      other.grad = add(other.grad, unbroadcast(matmul(selfT, out.grad), other.data.shape));
    };
    return out;
  }

  transpose(ax1: number, ax2: number): Tensor {
    const out = new Tensor(swapaxes(this.data, ax1, ax2), [this], this.requires_grad);
    out._backward = () => { this.grad = add(this.grad, swapaxes(out.grad, ax1, ax2)); };
    return out;
  }

  reshape(...shape: number[]): Tensor {
    const out = new Tensor(this.data.reshape(...shape), [this], this.requires_grad);
    out._backward = () => { this.grad = add(this.grad, out.grad.reshape(...this.data.shape)); };
    return out;
  }

  relu(): Tensor {
    const out = new Tensor(relu(this.data), [this], this.requires_grad);
    out._backward = () => { this.grad = add(this.grad, mul(out.grad, greater(this.data, 0))); };
    return out;
  }

  tanh(): Tensor {
    const out = new Tensor(tanh(this.data), [this], this.requires_grad);
    out._backward = () => { this.grad = add(this.grad, mul(out.grad, sub(onesLike(out.data), square(out.data)))); };
    return out;
  }

  clamp(minVal?: number, maxVal?: number): Tensor {
    const out = new Tensor(clip(this.data, minVal, maxVal), [this], this.requires_grad);
    out._backward = () => {
      let mask = onesLike(this.data);
      if (minVal !== undefined) mask = mul(mask, greaterEqual(this.data, minVal));
      if (maxVal !== undefined) mask = mul(mask, lessEqual(this.data, maxVal));
      this.grad = add(this.grad, mul(out.grad, mask));
    };
    return out;
  }

  abs(): Tensor {
    const out = new Tensor(abs(this.data), [this], this.requires_grad);
    out._backward = () => { this.grad = add(this.grad, mul(out.grad, sign(this.data))); };
    return out;
  }

  maskedFill(mask: NDArray, value: number): Tensor {
    const outData = where(mask, value, this.data);
    const out = new Tensor(outData, [this], this.requires_grad);
    out._backward = () => { this.grad = add(this.grad, where(mask, zerosLike(out.grad), out.grad)); };
    return out;
  }

  softmax(axis = -1): Tensor {
    const maxVal = max(this.data, axis, true);
    const exps = exp(sub(this.data, maxVal));
    const probs = div(exps, sum(exps, axis, true));
    const out = new Tensor(probs, [this], this.requires_grad);
    out._backward = () => {
      const s = out.data;
      const sumGradS = sum(mul(out.grad, s), axis, true);
      this.grad = add(this.grad, mul(s, sub(out.grad, sumGradS)));
    };
    return out;
  }

  crossEntropy(targets: Tensor): Tensor {
    const targetsData = targets.data;
    const logits = this.data;
    const maxLogits = max(logits, -1, true);
    const exps = exp(sub(logits, maxLogits));
    const probs = div(exps, sum(exps, -1, true));

    const batchSize = targetsData.shape[0];
    const seqLen = targetsData.shape[1];
    let lossVal = 0;
    for (let b = 0; b < batchSize; b++) {
      for (let t = 0; t < seqLen; t++) {
        const idx = targetsData.get(b, t);
        lossVal -= Math.log(probs.get(b, t, idx) + 1e-10);
      }
    }
    lossVal /= batchSize * seqLen;

    const out = new Tensor(lossVal, [this], this.requires_grad);
    out._backward = () => {
      const dLogits = probs.copy();
      for (let b = 0; b < batchSize; b++) {
        for (let t = 0; t < seqLen; t++) {
          const idx = targetsData.get(b, t);
          dLogips.set(b, t, idx, dLogits.get(b, t, idx) - 1);
        }
      }
      this.grad = add(this.grad, div(dLogits, batchSize * seqLen));
    };
    return out;
  }

  sub(other: Tensor | number): Tensor { return this.add((other instanceof Tensor ? other : new Tensor(other)).mul(-1 as any)); }
  div(other: Tensor | number): Tensor { return this.mul(Math.pow(other instanceof Tensor ? other.data.getAll()[0] : other, -1) as any); }
  pow(power: number): Tensor {
    const out = new Tensor(pow(this.data, power), [this], this.requires_grad);
    out._backward = () => { this.grad = add(this.grad, mul(out.grad, mul(pow(this.data, power - 1), power))); };
    return out;
  }
  sum(axis?: number | null, keepdims = false): Tensor {
    const out = new Tensor(sum(this.data, axis ?? undefined, keepdims), [this], this.requires_grad);
    out._backward = () => {
      let grad = out.grad;
      if (axis !== null && !keepdims) grad = expandDims(grad, axis);
      this.grad = add(this.grad, broadcastTo(grad, this.data.shape));
    };
    return out;
  }
  mean(axis?: number | null, keepdims = false): Tensor {
    const out = new Tensor(mean(this.data, axis ?? undefined, keepdims), [this], this.requires_grad);
    out._backward = () => {
      let grad = out.grad;
      if (axis !== null && !keepdims) grad = expandDims(grad, axis);
      const n = axis === null ? this.data.size : this.data.shape[axis];
      this.grad = add(this.grad, div(broadcastTo(grad, this.data.shape), n));
    };
    return out;
  }
  neg(): Tensor { return this.mul(-1 as any); }

  get T(): Tensor { return this.transpose(-1, -2); }
}

export function cat(tensors: Tensor[], axis = 0): Tensor {
  const data = concatenate(tensors.map(t => t.data), axis);
  const requiresGrad = tensors.some(t => t.requires_grad);
  const out = new Tensor(data, tensors, requiresGrad);
  out._backward = () => {
    if (!out.requires_grad) return;
    const splitSizes = tensors.map(t => t.data.shape[axis]);
    const cumSum: number[] = [];
    for (let i = 0; i < splitSizes.length - 1; i++) {
      cumSum.push(splitSizes.slice(0, i + 1).reduce((a, b) => a + b, 0));
    }
    const grads = split(out.grad, cumSum, axis);
    tensors.forEach((t, i) => {
      if (t.requires_grad) t.grad = add(t.grad, grads[i]);
    });
  };
  return out;
}