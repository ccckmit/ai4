use crate::tensor::Tensor;

pub fn mse_loss(input: &Tensor, target: &Tensor) -> Tensor {
    let diff = input.sub(target);
    let diff_data = diff.data.borrow();
    let n = diff_data.len() as f32;
    let loss = diff_data.iter().map(|v| v * v).sum::<f32>() / n;
    drop(diff_data);

    let mut out = Tensor::new(vec![loss], vec![1], input.requires_grad || target.requires_grad);
    out._prev = vec![input.clone(), target.clone()];

    let out_data_rc = out.data.clone();
    let self_grad = input.grad.clone();
    let target_grad = target.grad.clone();
    let diff_data_rc = diff.data.clone();

    out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
        let out_g = out_data_rc.borrow();
        let diff = diff_data_rc.borrow();
        let n = diff.len() as f32;
        let grad_val = 2.0 * out_g[0] / n;
        let mut sg = self_grad.borrow_mut();
        let mut tg = target_grad.borrow_mut();
        for i in 0..diff.len() {
            sg[i] += diff[i] * grad_val;
            tg[i] -= diff[i] * grad_val;
        }
    }))));
    out
}

use std::cell::RefCell;
use std::rc::Rc;

pub trait Module {
    fn parameters(&self) -> Vec<Tensor>;
    fn forward(&self, x: &Tensor) -> Tensor;
}

pub struct Sequential {
    modules: Vec<Box<dyn Module>>,
}

impl Sequential {
    pub fn new(modules: Vec<Box<dyn Module>>) -> Self {
        Sequential { modules }
    }
}

impl Module for Sequential {
    fn parameters(&self) -> Vec<Tensor> {
        let mut params = Vec::new();
        for m in &self.modules {
            params.extend(m.parameters());
        }
        params
    }

    fn forward(&self, x: &Tensor) -> Tensor {
        let mut out = x.clone();
        for m in &self.modules {
            out = m.forward(&out);
        }
        out
    }
}

pub struct ReLU;

impl ReLU {
    pub fn new() -> Self { ReLU }
}

impl Module for ReLU {
    fn parameters(&self) -> Vec<Tensor> { vec![] }
    fn forward(&self, x: &Tensor) -> Tensor { x.relu() }
}

pub struct Tanh;

impl Tanh {
    pub fn new() -> Self { Tanh }
}

impl Module for Tanh {
    fn parameters(&self) -> Vec<Tensor> { vec![] }
    fn forward(&self, x: &Tensor) -> Tensor { x.tanh() }
}

pub struct Linear {
    weight: Tensor,
    bias: Option<Tensor>,
}

impl Linear {
    pub fn new(in_features: usize, out_features: usize, bias: bool) -> Self {
        let weight = Tensor::randn(&[in_features, out_features]);
        let bias = if bias { Some(Tensor::zeros(&[out_features])) } else { None };
        Linear { weight, bias }
    }
}

impl Module for Linear {
    fn parameters(&self) -> Vec<Tensor> {
        let mut params = vec![self.weight.clone()];
        if let Some(ref b) = self.bias {
            params.push(b.clone());
        }
        params
    }

    fn forward(&self, x: &Tensor) -> Tensor {
        let out = x.matmul(&self.weight);
        if let Some(ref b) = self.bias {
            out.add(b)
        } else {
            out
        }
    }
}

pub struct Embedding {
    weight: Tensor,
}

impl Embedding {
    pub fn new(num_embeddings: usize, embedding_dim: usize) -> Self {
        let weight = Tensor::randn(&[num_embeddings, embedding_dim]);
        Embedding { weight }
    }
}

impl Module for Embedding {
    fn parameters(&self) -> Vec<Tensor> { vec![self.weight.clone()] }

    fn forward(&self, indices: &[usize]) -> Tensor {
        let num_embeddings = self.weight.shape[0];
        let embedding_dim = self.weight.shape[1];
        let seq_len = indices.len();
        let mut out_data = vec![0.0; seq_len * embedding_dim];
        let weight_data = self.weight.data.borrow();

        for (i, &idx) in indices.iter().enumerate() {
            for j in 0..embedding_dim {
                out_data[i * embedding_dim + j] = weight_data[idx * embedding_dim + j];
            }
        }
        drop(weight_data);

        let mut out = Tensor::new(out_data, vec![seq_len, embedding_dim], true);
        out._prev = vec![self.weight.clone()];

        let weight_data_rc = self.weight.data.clone();
        let out_data_rc = out.data.clone();
        let indices_copy = indices.to_vec();
        let embedding_dim_copy = embedding_dim;

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let out_g = out_data_rc.borrow();
            let mut w = weight_data_rc.borrow_mut();
            for (i, &idx) in indices_copy.iter().enumerate() {
                for j in 0..embedding_dim_copy {
                    w[idx * embedding_dim_copy + j] += out_g[i * embedding_dim_copy + j];
                }
            }
        }))));
        out
    }
}

pub struct RMSNorm {
    eps: f32,
    scale: Tensor,
}

impl RMSNorm {
    pub fn new(dim: usize, eps: f32) -> Self {
        RMSNorm { eps, scale: Tensor::ones(&[dim]) }
    }
}

impl Module for RMSNorm {
    fn parameters(&self) -> Vec<Tensor> { vec![] }

    fn forward(&self, x: &Tensor) -> Tensor {
        let x_data = x.data.borrow();
        let n = x_data.len();
        let ms = x_data.iter().map(|v| v * v).sum::<f32>() / n as f32 + self.eps;
        let inv_std = 1.0 / ms.sqrt();
        let out_data: Vec<f32> = x_data.iter().map(|v| v * inv_std).collect();
        drop(x_data);

        let mut out = Tensor::new(out_data, x.shape.clone(), x.requires_grad);
        out._prev = vec![x.clone()];

        let out_data_rc = out.data.clone();
        let x_data_rc = x.data.clone();
        let self_grad = x.grad.clone();
        let inv_std_copy = inv_std;
        let n_copy = n;

        out._backward = Rc::new(RefCell::new(Some(Box::new(move || {
            let out_g = out_data_rc.borrow();
            let x_d = x_data_rc.borrow();
            let mut sg = self_grad.borrow_mut();
            let sum_gx: f32 = out_g.iter().zip(x_d.iter()).map(|(g, x)| g * x).sum();
            for i in 0..n_copy {
                sg[i] += out_g[i] * inv_std_copy - x_d[i] * inv_std_copy.powi(3) * sum_gx / n_copy as f32;
            }
        }))));
        out
    }
}

pub struct Adam {
    params: Vec<Tensor>,
    lr: f32,
    beta1: f32,
    beta2: f32,
    eps: f32,
    m: Vec<Vec<f32>>,
    v: Vec<Vec<f32>>,
    t: usize,
}

impl Adam {
    pub fn new(params: Vec<Tensor>, lr: f32, betas: (f32, f32), eps: f32) -> Self {
        let m = params.iter().map(|p| vec![0.0; p.data.borrow().len()]).collect();
        let v = params.iter().map(|p| vec![0.0; p.data.borrow().len()]).collect();
        Adam { params, lr, beta1: betas.0, beta2: betas.1, eps, m, v, t: 0 }
    }

    pub fn step(&mut self) {
        self.t += 1;
        for (i, p) in self.params.iter().enumerate() {
            let p_data = p.data.borrow();
            let p_grad = p.grad.borrow();
            let n = p_data.len();

            for j in 0..n {
                self.m[i][j] = self.beta1 * self.m[i][j] + (1.0 - self.beta1) * p_grad[j];
                self.v[i][j] = self.beta2 * self.v[i][j] + (1.0 - self.beta2) * p_grad[j] * p_grad[j];
            }
            drop(p_grad);

            let m_hat: Vec<f32> = self.m[i].iter().map(|mv| mv / (1.0 - self.beta1.powi(self.t as i32))).collect();
            let v_hat: Vec<f32> = self.v[i].iter().map(|vv| vv / (1.0 - self.beta2.powi(self.t as i32))).collect();

            let mut p_data_mut = p.data.borrow_mut();
            for j in 0..n {
                p_data_mut[j] -= self.lr * m_hat[j] / (v_hat[j].sqrt() + self.eps);
            }
        }
    }

    pub fn zero_grad(&self) {
        for p in &self.params {
            p.zero_grad();
        }
    }
}